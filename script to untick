// ==UserScript==
// @name         LinkedIn Easy Apply - Auto Untick Follow Company
// @namespace    https://github.com/t4r1k255/LinkedIn-untick-when-asked-to-follow
// @version      1.2
// @description  Automatically unticks "Follow company" checkbox in LinkedIn Easy Apply
// @author       t4r1k255
// @match        https://www.linkedin.com/jobs/*
// @grant        none
// @run-at       document-idle
// @license      MIT
// ==/UserScript==

(function () {
    'use strict';

    const LOG = '[DONTFOLLOW]';

    const nativeCheckedSetter =
        Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'checked')?.set;

    function log(...args) {
        console.log(LOG, ...args);
    }

    function getModal() {
        return document.querySelector('.jobs-easy-apply-modal, .artdeco-modal');
    }

    function getCheckbox() {
        const modal = getModal();
        if (!modal) return null;

        return modal.querySelector('#follow-company-checkbox');
    }

    function uncheckCheckbox() {
        const checkbox = getCheckbox();
        if (!checkbox) return false;

        if (!checkbox.checked) return true;

        try {
            if (nativeCheckedSetter) {
                nativeCheckedSetter.call(checkbox, false);
            } else {
                checkbox.checked = false;
            }

            checkbox.dispatchEvent(new Event('input', { bubbles: true }));
            checkbox.dispatchEvent(new Event('change', { bubbles: true }));

            // Bazı UI durumlarında label yeniden çizilsin diye microtask sonrası tekrar bak
            queueMicrotask(() => {
                if (checkbox.checked) {
                    if (nativeCheckedSetter) {
                        nativeCheckedSetter.call(checkbox, false);
                    } else {
                        checkbox.checked = false;
                    }
                    checkbox.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });

            log('Checkbox unchecked');
            return !checkbox.checked;
        } catch (err) {
            log('Failed to uncheck:', err);
            return false;
        }
    }

    function scheduleUncheckSequence() {
        [0, 100, 250, 500, 900, 1400].forEach(delay => {
            setTimeout(uncheckCheckbox, delay);
        });
    }

    // Modal içindeki step geçişleri ve buton tıklamaları sonrası tekrar kontrol et
    document.addEventListener('click', (e) => {
        const btn = e.target.closest('button, [role="button"], label');
        if (!btn) return;

        const modal = getModal();
        if (!modal) return;

        if (modal.contains(btn)) {
            scheduleUncheckSequence();
        }
    }, true);

    // DOM değişimlerini genel olarak izle
    const observer = new MutationObserver((mutations) => {
        let shouldCheck = false;

        for (const mutation of mutations) {
            if (mutation.type === 'childList') {
                if (mutation.addedNodes.length || mutation.removedNodes.length) {
                    shouldCheck = true;
                    break;
                }
            }

            if (mutation.type === 'attributes') {
                shouldCheck = true;
                break;
            }
        }

        if (shouldCheck && getModal()) {
            scheduleUncheckSequence();
        }
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['class', 'aria-hidden', 'aria-checked']
    });

    // En sağlam fallback: modal açıkken düzenli kontrol
    setInterval(() => {
        if (getModal()) {
            uncheckCheckbox();
        }
    }, 700);

    // İlk yükleme
    scheduleUncheckSequence();

    log('Script active');
})();
